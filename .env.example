# Clé d'API Google Gemini (Accepte une clé brute ou une clé chiffrée enc:...)
# Si vous la chiffrez avec "npm run encrypt", collez la valeur enc:... ici
GEMINI_API_KEY=your_gemini_api_key_or_enc_string_here

# Phrase secrète de déchiffrement AES-256-GCM (si clé chiffrée)
ENCRYPTION_SECRET=sunty-secure-vault-passphrase-2026

# Modèle par défaut
DEFAULT_MODEL=gemini-3.8-flash

# Port local
PORT=3000
